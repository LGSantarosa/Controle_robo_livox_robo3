<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_base</name>
  <version>0.1.0</version>
  <description>
    Base do robô 2: tração (hoverboard via ros2_control) e localização
    (Livox Mid-360 + FAST-LIO). É a camada verificada em hardware — a
    movimentação/navegação NÃO mora aqui.
  </description>
  <maintainer email="luizgustavo.santarosa@gmail.com">Luiz Santarosa</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <!-- `tf_odom` lê as rodas em std_msgs/Float64 (decisão 050). Estava faltando:
       funciona hoje por vir de carona no ambiente, e quebra em build limpo. -->
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <!-- `nuvem_pontos` lê o CustomMsg cru e empacota com numpy (decisão 066). -->
  <exec_depend>python3-numpy</exec_depend>

  <!-- Tração: interface ros2_control da placa hover + controlador diferencial -->
  <exec_depend>hoverboard_driver</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>

  <!-- Localização: `livox_ros_driver2` (Mid-360) e `fast_lio` (odometria LIO).
       Dependências REAIS em tempo de execução, mas DE PROPÓSITO não declaradas
       aqui: são clonadas por setup_livox.sh e ficam fora do git, então declará-las
       torna este pacote impossível de compilar antes de o script rodar
       ("Failed to find .../fast_lio/package.sh") — e o rosdep não sabe instalá-las
       de qualquer forma, já que não estão em repositório de pacotes.
       Em vez disso, localizacao.launch.py falha com mensagem explícita mandando
       rodar o setup_livox.sh, que é onde a falta realmente importa. -->

  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
